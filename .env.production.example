# Kopyala: cp .env.production.example .env.production  (dosya git'e girmez)
POSTGRES_PASSWORD=değiştir-uzun-rastgele
# openssl rand -hex 32
JWT_SECRET=değiştir-en-az-48-karakter
# Tarayıcıda kullanılan adres (Origin denetimi). HTTPS arkasında https://alanadi.example
WEB_ORIGIN=http://127.0.0.1:8080
# Caddy/Nginx arkasında 1; doğrudan 127.0.0.1:8080 denemesinde boş bırak
TRUST_PROXY=
# Üretimde e-posta gerçekten gönderilmez; "file" bağlantıları var/mail altına yazar
MAIL_TRANSPORT=file
ADMIN_EMAILS=
SOURCE_MANAGER_EMAILS=
# Aşağıdakiler isteğe bağlı
AI_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
RAG_SEARCH_BACKEND=local
