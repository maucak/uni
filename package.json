{
  "name": "kampuspusula",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "catalog:pilot": "node scripts/catalog-import.ts data/pilot-isubu-2026-10.json --apply",
    "dev": "node scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.ts --dev-login",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.ts",
    "db:migrate": "node scripts/migrate.ts",
    "db:seed": "node scripts/seed.ts",
    "test": "node --test tests/*.test.ts",
    "test:integration": "node scripts/smoke.ts",
    "catalog:import": "node scripts/catalog-import.ts",
    "db:update-local": "node scripts/database-update.ts",
