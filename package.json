{
  "name": "kampuspusula",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "life:sync": "node scripts/life-sync.ts",
    "rag:models": "node scripts/rag-models.ts",
    "rag:index": "node scripts/rag-index.ts",
    "rag:search": "node scripts/rag-search.ts",
    "rag:setup": "node scripts/rag-setup.ts",
    "rag:refresh": "node scripts/rag-refresh.ts",
    "rag:evaluate": "node scripts/rag-evaluate.ts",
    "rag:report": "node scripts/rag-report.ts",
    "eval:recommend": "node scripts/eval-recommend.ts",
    "eval:rag": "node scripts/eval-rag.ts",
    "rag:index:local": "node scripts/rag-index.ts --lexical-only",
    "catalog:pilot": "node scripts/catalog-import.ts data/pilot-isubu-2026-10.json --apply",
    "dev": "node scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch-path=server --watch-path=shared server/index.ts --dev-login",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{src,server,shared,scripts,tests}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{src,server,shared,scripts,tests}/**/*.{ts,tsx,css}\"",
    "check": "npm run typecheck && npm run format:check && npm test",
    "start": "node server/index.ts",
    "db:migrate": "node scripts/migrate.ts",
    "db:seed": "node scripts/seed.ts",
    "db:backup": "node scripts/db-backup.ts",
    "db:restore": "node scripts/db-restore.ts",
    "db:backup-check": "node scripts/backup-check.ts",
    "test": "node --test tests/*.test.ts",
    "test:integration": "node scripts/smoke.ts && node scripts/verification-check.ts && node scripts/mentorship-check.ts",
    "catalog:import": "node scripts/catalog-import.ts",
    "db:update-local": "node scripts/database-update.ts",
    "catalog:osym": "node scripts/catalog-import.ts data/osym-2026-all.json --apply",
    "rag:qdrant:index": "node scripts/rag-qdrant-index.ts",
    "rag:qdrant:start": "docker compose -f compose.rag.yaml up -d",
    "sources:worker": "node scripts/source-worker.ts",
    "sources:check": "node scripts/source-worker.ts --once"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
