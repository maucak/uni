# npm run dev creates a local PostgreSQL cluster when this is empty.
DATABASE_URL=
PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
# Required in production; development launcher generates a local secret.
JWT_SECRET=

# AI is disabled until a key AND a model are configured. Keep keys on the server.
AI_PROVIDER=groq
GEMINI_API_KEY=
# Select a currently available model supporting structured JSON outputs.
GEMINI_MODEL=
AI_DAILY_LIMIT=10

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
