# npm run dev creates a local PostgreSQL cluster when this is empty.
DATABASE_URL=
PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
# Required in production; development launcher generates a local secret.
JWT_SECRET=

# AI is disabled until a key AND a model are configured. Keep keys on the server.
AI_PROVIDER=groq
GEMINI_API_KEY=
# Select a currently available model supporting structured JSON outputs.
GEMINI_MODEL=
AI_DAILY_LIMIT=10

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional explicit conversation planner model; empty uses the answer model.
AI_ROUTER_MODEL=

# Only honored by the explicit development launcher; production ignores it.
AI_DEV_DAILY_LIMIT=100

# Search backend: local during migration, qdrant after verified publication.
RAG_SEARCH_BACKEND=local
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=kampus_knowledge
# Generate a random secret locally; never commit the real value.
QDRANT_API_KEY=

# Comma-separated source managers; production has no development-account exception.
SOURCE_MANAGER_EMAILS=

# Comma-separated e-mails that receive the admin role at API start-up (accounts must exist).
ADMIN_EMAILS=
